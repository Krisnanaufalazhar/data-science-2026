    {
      "cell_type": "markdown",
      "source": [
        "##Handling Missing Values"
      ],
      "metadata": {
        "id": "jO8W3ukpg6q8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Isi age dengan median\n",
        "df['age'] = df['age'].fillna(df['age'].median())\n",
        "\n",
        "# Isi embarked dengan modus\n",
        "df['embarked'] = df['embarked'].fillna(df['embarked'].mode()[0])\n",
        "\n",
        "print(\"Missing Values Setelah Handling:\")\n",
        "print(df.isnull().sum())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "m76ivping-2I",
        "outputId": "83d60079-d97f-4f3d-85f8-fd23b2882b66"
